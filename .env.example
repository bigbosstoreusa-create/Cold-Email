# =========================================================================
# CyberAudit - Variables d'environnement
# Copiez ce fichier en ".env" puis remplissez vos valeurs :  cp .env.example .env
# NE COMMITTEZ JAMAIS votre fichier ".env" reel (il est deja ignore par git).
# =========================================================================

# Marque affichee (marque blanche).
SCANNER_BRAND=CyberAudit

# Prix et devise affiches sur l'ecran de deverrouillage.
ACCESS_PRICE=29
ACCESS_CURRENCY=USD

# Lien du bouton "Obtenir l'acces" (votre page de vente Gumroad / Stripe).
PAYMENT_URL=https://votreboutique.gumroad.com/l/xxxx

# Verification automatique des licences Gumroad (optionnel mais recommande).
# Renseignez l'un OU l'autre (product_id de preference).
GUMROAD_PRODUCT_ID=
GUMROAD_PRODUCT_PERMALINK=

# Compte administrateur (acces total gratuit).
ADMIN_EMAIL=kplaaka@gmail.com
ADMIN_PASSWORD=changez-moi-par-un-mot-de-passe-solide

# Cle proprietaire (optionnel : si vide, elle est generee au 1er lancement).
OWNER_KEY=
